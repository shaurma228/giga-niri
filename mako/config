# Уведомления giga-niri (Tokyo Glass). Перечитать: makoctl reload
# Блюр под ними даёт niri (layer-rule для namespace "notifications").

font=Inter 11
width=380
padding=14,18
# margin=0: поверхность слоя ровно по карточке, иначе блюр niri
# закрашивает прямоугольник вокруг скруглённых углов. Отступ от края — outer-margin.
margin=0
outer-margin=14,14,0,0
max-visible=4
border-size=2
border-radius=18
icons=1
max-icon-size=48
icon-path=/home/goydaslav/.local/share/icons/Tela-dark
default-timeout=6000
anchor=top-right

background-color=#1a1b26cc
text-color=#c0caf5
border-color=#7aa2f7cc
progress-color=over #7aa2f744

format=<b>%s</b>\n%b

[urgency=low]
border-color=#565f89cc

[urgency=critical]
border-color=#f7768e
default-timeout=0

[mode=do-not-disturb]
invisible=1
