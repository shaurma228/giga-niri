// СГЕНЕРИРОВАНО scripts/build-animations.py из niri/animations.kdl.in и shaders/*.frag.
// Не править вручную.

// Анимации в духе macOS: плавные пружины без отскока.
// Шаблон: маркер @shader + (имя) заменяется на shaders/<имя>.frag.
// Сборка: python3 -I scripts/build-animations.py

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // Открытие: окно вырастает и проявляется
    window-open {
        duration-ms 280
        curve "ease-out-expo"
        custom-shader r#"
// Открытие окна в духе macOS: окно плавно вырастает из чуть меньшего размера,
// приподнимаясь и проявляясь. Без блика и эффектов — спокойно, как у Apple.
//
// coords_geo: координаты пикселя относительно окна (0..1), size_geo: размер окна в px.
// Цвет возвращается premultiplied.

vec4 open_color(vec3 coords_geo, vec3 size_geo) {
    float p = niri_clamped_progress;

    float scale = mix(0.9, 1.0, p);
    vec2 uv = (coords_geo.xy - 0.5) / scale + 0.5;
    uv.y += (1.0 - p) * 0.02;

    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return vec4(0.0);

    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
    return color * smoothstep(0.0, 0.6, p);
}
"#
    }

    // Закрытие: окно сжимается и гаснет
    window-close {
        duration-ms 220
        curve "ease-out-quad"
        custom-shader r#"
// Закрытие окна в духе macOS: окно сжимается к центру и быстро гаснет.

vec4 close_color(vec3 coords_geo, vec3 size_geo) {
    float p = niri_clamped_progress;

    float scale = mix(1.0, 0.88, p);
    vec2 uv = (coords_geo.xy - 0.5) / scale + 0.5;

    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return vec4(0.0);

    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
    return color * (1.0 - smoothstep(0.0, 0.85, p));
}
"#
    }
}
