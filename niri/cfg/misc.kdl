// Окружение и мелочи. Переменные действуют только на программы,
// запущенные из niri, и не попадают в сессию KDE.

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // Qt-приложения выглядят как в Plasma (plasma-integration)
    QT_QPA_PLATFORMTHEME "kde"
}

// Курсор как в KDE
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
}

prefer-no-csd

// Параметры блюра для всех окон и панелей с background-effect { blur true; }
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.4
}

screenshot-path "~/Pictures/Screenshots/niri-%Y-%m-%d_%H-%M-%S.png"

// Подсказка по клавишам при старте. Отключить: skip-at-startup
hotkey-overlay {
}
