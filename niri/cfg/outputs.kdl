// Мониторы. Расположение как в KDE: ноутбук слева, MSI справа и он основной.
// Без частоты в mode niri берёт максимальную для этого разрешения.
// Имена выходов: niri msg outputs

// MSI 2560x1440 @ 100 Гц по HDMI
output "HDMI-A-1" {
    mode "2560x1440"
    scale 1
    position x=1920 y=0
    focus-at-startup
}

// Встроенный BOE 1920x1080 @ 144 Гц. При закрытой крышке niri сам его выключает.
output "eDP-1" {
    mode "1920x1080"
    scale 1
    position x=0 y=0
}
