// Правила окон.

// Скругления у всех окон. clip-to-geometry обрезает содержимое по скруглению.
// draw-border-with-background false: рамка фокуса только по контуру,
// иначе её заливка просвечивает сквозь полупрозрачные окна.
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    draw-border-with-background false
}

// Матовое стекло: блюр под полупрозрачными окнами.
// По умолчанию xray: размываются только обои, а не окна под окном.
// Это считается один раз и почти не нагружает видеокарту.
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
    }
}

// Бар: стекло (xray-блюр обоев под полупрозрачной полосой)
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
}

// Лаунчер: настоящий блюр (размывает и окна под собой, а не только обои).
// Он открыт секунды, поэтому дорогой блюр здесь допустим.
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 24
    background-effect {
        blur true
        xray false
    }
}

// Всплывающие карточки (giga-niri/shell): настоящий блюр и тень, как у лаунчера
layer-rule {
    match namespace="^giga-popup$"
    geometry-corner-radius 20
    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=8
        color "#0000008c"
    }
    background-effect {
        blur true
        xray false
    }
}

// Уведомления: xray-блюр, как у бара
layer-rule {
    match namespace="^notifications$"
    geometry-corner-radius 18
    background-effect {
        blur true
    }
}

// Обои видны и в Overview (за уменьшенными рабочими столами)
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// Картинка в картинке (Firefox, Chrome) — плавающим окном
window-rule {
    match title="^Picture[- ]in[- ][Pp]icture$"
    open-floating true
}
