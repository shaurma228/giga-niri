// Правила окон и панелей в стиле macOS 27 (Liquid Glass).

// Скругления у всех окон, как в macOS 27 — одинаковые везде.
// clip-to-geometry обрезает содержимое по скруглению.
// draw-border-with-background false: контур только по краю,
// иначе он просвечивает сквозь полупрозрачные окна.
window-rule {
    geometry-corner-radius 22
    clip-to-geometry true
    draw-border-with-background false
}

// Неактивные окна: тень мягче, активное «ближе» (macOS 27: активные окна заметнее)
window-rule {
    match is-focused=false
    shadow {
        softness 36
        offset x=0 y=8
        color "#00000059"
    }
}

// Стекло: блюр под полупрозрачным терминалом.
// xray (по умолчанию): размываются только обои — почти бесплатно для видеокарты.
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
    }
}

// Строка меню: лёгкое стекло поверх обоев
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
}

// Меню на fuzzel (питание, подсказка): настоящий блюр — размывает и окна под собой.
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 22
    shadow {
        on
        softness 60
        spread 0
        offset x=0 y=20
        color "#000000a6"
    }
    background-effect {
        blur true
        xray false
    }
}

// Поиск по системе (giga-niri/shell/SearchWindow.qml), как Spotlight
layer-rule {
    match namespace="^giga-search$"
    geometry-corner-radius 22
    shadow {
        on
        softness 60
        spread 0
        offset x=0 y=20
        color "#000000a6"
    }
    background-effect {
        blur true
        xray false
    }
}

// Пункт управления и карточки (giga-niri/shell): настоящий блюр и тень
layer-rule {
    match namespace="^giga-popup$"
    geometry-corner-radius 22
    shadow {
        on
        softness 50
        spread 0
        offset x=0 y=14
        color "#00000099"
    }
    background-effect {
        blur true
        xray false
    }
}

// Системное меню (giga-niri/shell/SystemMenu.qml), как меню Apple в macOS
layer-rule {
    match namespace="^giga-system$"
    geometry-corner-radius 22
    shadow {
        on
        softness 50
        spread 0
        offset x=0 y=14
        color "#00000099"
    }
    background-effect {
        blur true
        xray false
    }
}

// Уведомления
layer-rule {
    match namespace="^notifications$"
    geometry-corner-radius 22
    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=8
        color "#00000080"
    }
    background-effect {
        blur true
        xray false
    }
}

// Обои видны и в Overview (за уменьшенными рабочими столами)
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// Картинка в картинке (Firefox, Chrome) — плавающим окном
window-rule {
    match title="^Picture[- ]in[- ][Pp]icture$"
    open-floating true
}
