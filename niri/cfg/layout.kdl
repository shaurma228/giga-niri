// Раскладка окон в стиле macOS 27: без цветной рамки фокуса, тонкий светлый
// контур как у окон macOS, мягкие тени (у активного окна глубже — rules.kdl).

layout {
    gaps 12
    center-focused-column "never"

    // Прозрачный фон рабочего стола, иначе он закрывает обои (awww)
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    // Волосяной контур: у активного окна ярче
    border {
        width 1
        active-color "#ffffff3d"
        inactive-color "#ffffff17"
        urgent-color "#ff453a"
    }

    shadow {
        on
        softness 50
        spread 0
        offset x=0 y=14
        color "#00000099"
    }
}
