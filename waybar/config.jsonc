// Строка меню giga-niri в стиле macOS 27: слева значок системы, имя активной
// программы и рабочие столы (тайлинг), справа значки состояния, Spotlight,
// Пункт управления и часы. Сгенерирована вручную, значки — Material Design Nerd Font.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "modules-left": [
        "custom/logo",
        "niri/window",
        "niri/workspaces"
    ],
    "modules-right": [
        "tray",
        "niri/language",
        "battery",
        "network",
        "custom/spotlight",
        "custom/control",
        "clock"
    ],
    "custom/logo": {
        "format": "󰣇",
        "tooltip-format": "Меню системы (Mod+Shift+Q)",
        "on-click": "~/.config/giga-niri/power-menu.sh"
    },
    "niri/window": {
        "format": "{app_id}",
        "separate-outputs": true,
        "icon": false,
        "rewrite": {
            "": "Рабочий стол",
            "Alacritty": "Терминал",
            "google-chrome": "Chrome",
            "firefox": "Firefox",
            "org.kde.dolphin": "Dolphin",
            "systemsettings": "Параметры системы",
            "code": "Code",
            "org.telegram.desktop": "Telegram",
            "steam": "Steam",
            "vesktop": "Discord",
            "Throne": "Throne",
            "(.*)": "$1"
        },
        "tooltip": false
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○"
        }
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "niri/language": {
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip-format": "{long}"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}%  ",
        "format-plugged": "{capacity}%  ",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}"
    },
    "network": {
        "interface": "wlan0",
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} · {signalStrength}%",
        "on-click": "qs -p ~/.config/giga-niri/shell ipc call popup toggle wifi"
    },
    "custom/spotlight": {
        "format": "󰍉",
        "tooltip-format": "Spotlight (Mod+D)",
        "on-click": "pkill -x fuzzel || fuzzel"
    },
    "custom/control": {
        "format": "󰔡",
        "tooltip-format": "Пункт управления",
        "on-click": "qs -p ~/.config/giga-niri/shell ipc call popup toggle control"
    },
    "clock": {
        "format": "{:L%a %d %b  %H:%M}",
        "locale": "ru_RU.utf8",
        "tooltip": false,
        "on-click": "qs -p ~/.config/giga-niri/shell ipc call popup toggle calendar"
    }
}
